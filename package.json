{
  "name": "@k99k5/dsh-suggest-card",
  "version": "0.0.1",
  "repository": {"type":"git","url":"git+https://github.com/k99k5/dsh-suggest-card.git"},
  "publishConfig": {"access":"public","registry":"https://registry.npmjs.org/"},
  "type": "module",
  "description": "Contextual task cards and decision replies for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "logic.js",
    "review.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.3.6"
  },
  "scripts": {
    "build": "esbuild client-entry.js --bundle --platform=browser --format=iife --outfile=client.js",
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
